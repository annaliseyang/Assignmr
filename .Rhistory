v2 = CC[row_2, c("Position.F1", "Position.F2")]
if (is_adj(v1, v2, tolerance)) {
print(TRUE)
append(out, TRUE)
break
}
}
# if no points found, append FALSE
if (row_2 >= nrow(CC)) {
append(out, FALSE)
}
}
return (out)
}
